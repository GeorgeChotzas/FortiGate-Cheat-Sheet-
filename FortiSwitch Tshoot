### FortiGate ###

execute switch-controller get-conn-status                          # Managed switches: status, version, serial
execute switch-controller diagnose-connection                      # FortiLink health check (CAPWAP, DHCP, LLDP, auth)
execute switch-controller get-physical-conn standard <fortilink>   # Physical topology of switches on a FortiLink
diagnose switch-controller switch-info mclag peer-consistency-check   # Check MC-LAG config consistency between peers
diagnose switch-controller switch-info mac-table <switch>          # MAC table of a managed switch
execute switch-controller get-upgrade-status                       # Firmware upgrade progress for managed switches

# Override local admin password on managed switches
config switch-controller switch-profile
edit default
set login-passwd-override enable
set login-passwd ***
end


### FSW - Crashlog / TAC ###

diagnose debug crashlog read      # Daemon crash history
diagnose debug report             # Full output for TAC


### FSW - System / Hardware ###

execute time                      # Current time on the switch
get system status                 # Firmware, serial, hostname, uptime
diagnose sys ntp status           # NTP sync status
get system arp                    # ARP table
get system performance status     # CPU, memory, uptime
get hardware status               # Model, ASIC, ports, PoE budget
get hardware cpu                  # CPU details
get hardware memory               # Memory details
diagnose hardware sysinfo shm     # Shared memory / conserve mode info
diagnose sys fan status           # Fan status
diagnose sys pcb temp             # Board temperature sensors
diagnose sys psu status           # Power supply status
diagnose sys flash list           # Firmware images on flash


### FSW - Physical Ports / Transceivers ###

diagnose switch physical-ports summary          # Port status, speed, duplex
diagnose switch physical-ports stats list       # Port counters (errors, drops)
diagnose switch physical-ports list             # Detailed port info
diagnose switch physical-ports port-stats list  # Per-port traffic stats
diagnose switch physical-ports linerate         # Live port throughput
diagnose switch physical-ports io-stats list    # Port I/O stats
diagnose switch physical-ports port-block status # Blocked ports (loop guard, etc.)
diagnose switch mac-address list                # MAC address table
diagnose netlink bridge list                    # Kernel bridge table
diagnose switch vlan list                       # VLANs and member ports


### FSW - PoE ###

get switch poe inline             # PoE power per port and total budget
diagnose switch poe status portX  # PoE details for one port
execute poe-reset portX           # Power-cycle PoE on a port


### FSW - LLDP ###

get switch lldp neighbors-summary   # LLDP neighbors overview
get switch lldp neighbors-detail    # Full neighbor details
get switch lldp auto-isl-status     # Auto-ISL detection status
get switch lldp stats               # LLDP packet counters
get switch lldp profile             # LLDP profiles
get switch lldp settings            # Global LLDP settings


### FSW - STP ###

get switch stp settings           # Global STP config
diagnose stp instance list        # STP state per instance/port (root, blocking)
diagnose stp mst-config list      # MST region config


### FSW - Interfaces, Trunks and MC-LAG ###

get switch interface                        # Switch interface config
diagnose switch trunk summary               # Trunk/LAG status overview
diagnose switch trunk list                  # Trunk/LAG member details
diagnose switch mclag icl                   # MC-LAG ICL status
diagnose switch mclag list                  # MC-LAG trunks and peer status
diagnose switch mclag peer-consistency-check # Config consistency with MC-LAG peer
get switch storm-control                    # Storm control settings


### FSW - Logs ###

execute log filter view-lines 5000   # Lines to display
execute log filter start-line 1      # Start from first line
execute log display                  # Show logs


