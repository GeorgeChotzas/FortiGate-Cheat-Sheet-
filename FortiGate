diag switch-controller switch-info port-stats      # Port statistics
diag switch-controller switch-info trunk           # Trunk info
diag switch-controller switch-info mclag           # MC-LAG info
exec switch-controller get-conn-status             # Switch connection status
exec switch-controller diagnose-connection <switch>   # Connection diagnostics


