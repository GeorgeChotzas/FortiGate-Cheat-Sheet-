##########################################################
###   FortiGate CLI Cheat Sheet - FortiOS 8.0          ###
##########################################################


### System - General ###

get system status                                  # Firmware, serial, HA, VDOM, license info
get system performance status                      # CPU, memory, sessions, uptime
exec tac report                                    # Full diagnostic report for Fortinet TAC
diag sys waninfo ipify                             # Show public IP of the FortiGate
diag debug config-error-log read                   # Config errors after a firmware upgrade
diag fdsm image-list                               # Firmware images available from FortiGuard
diag fdsm image-upgrade-matrix                     # Supported upgrade path
Upgrade path tool:   https://docs.fortinet.com/upgrade-tool/fortigate
Firmware download:   https://support.fortinet.com/support/#/downloads/firmware


### Firmware Upgrade Checklist ###

# 1) Pre-upgrade - save output to a file
get system status
get system performance status
diag hardware deviceinfo disk
get system interface
diag netlink interface list
diag ip address list
get router info routing-table all
get system ha status
diag autoupdate versions
diag vpn ike gateway list
diag vpn tunnel list
get vpn ipsec tunnel summary

# 2) After every hop in the upgrade path
get system status
diag debug config-error-log read
diag debug crashlog read

# 3) Post-upgrade - run the same commands as step 1
# 4) Diff pre-upgrade vs post-upgrade output


### System - Processes & Memory ###

diag sys top [sec] [number] [iterations]           # Live process list (P = sort CPU, M = sort memory, Ctrl+C to stop)
diag sys top-summary                               # Process summary
diag sys top-summary "-s mem"                      # Process summary sorted by memory
diag sys process dump <pid>                        # Details of one process
diag hardware sysinfo memory                       # Memory usage
diag hardware sysinfo slab                         # Kernel slab memory
diag debug crashlog read                           # Crash log


### Conserve Mode ###

diag debug crashlog read                           # Look for conserve / killed processes
diag hardware sysinfo conserve                     # Conserve mode state and thresholds
diag hardware sysinfo shm                          # Shared memory (conserve: 0=no, 1=proxy, 2=system, 3=both)
diag ips session status                            # IPS session memory usage

# Memory tuning for small / low-memory models - test first, adjust to the device
config system dns
    set dns-cache-limit 1800
end

config system fortiguard
    set webfilter-cache-ttl 1800
    set antispam-cache-ttl 900
end

config system autoupdate schedule
    set frequency daily
    set time 03:00
end

config ips global
    set engine-count 1
    set cp-accel-mode none
    set exclude-signatures none
end

config system global
    set memory-use-threshold-red 96
    set memory-use-threshold-extreme 97
    set memory-use-threshold-green 95
    set security-rating-result-submission disable
    set security-rating-run-on-schedule disable
    set tcp-halfclose-timer 30
    set tcp-halfopen-timer 5
    set tcp-timewait-timer 0
    set udp-idle-timer 60
    set miglogd-children 1
    set sslvpn-max-worker-count 1                  # Only if SSL-VPN still exists on the model/version
    set wad-worker-count 1
    set scanunit-count 2
    set internet-service-database on-demand
end

exec update-ffdb-on-demand                         # Refresh ISDB after switching to on-demand


### System - Debugging Basics ###

diag debug reset                                   # Clear all debug settings
diag debug console timestamp enable                # Add timestamps to debug output
diag debug application ?                           # List debuggable daemons
diag debug application <app> <level>               # Real-time debug for a daemon
diag test application <app> <test_level>           # Status info for a daemon
diag debug cli 7                                   # Show GUI changes as CLI commands
diag debug enable                                  # Start debug output
diag debug disable                                 # Stop debug output


