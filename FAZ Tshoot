### FortiGate ###

get log fortianalyzer setting              # FAZ logging config (IP, status, encryption)
get log fortianalyzer filter               # Which log types are sent to FAZ
exec log fortianalyzer test-connectivity   # Registration, connection, and quota status with FAZ
exec telnet <FAZ IP> 514                   # Test TCP 514 reachability to FAZ
diagnose sniffer packet any 'port 514' 4   # Check log traffic leaving the FortiGate
diagnose test application fgtlogd 1        # FAZ logging daemon stats, queued/failed logs (FOS 7.x)


### FAZ - General Health ###

get sys status                     # Firmware, serial, ADOM mode, time, HA, license status
get sys performance                # CPU, memory, disk usage, and I/O stats
exe top                            # Live process list with CPU load
exe iotop -b -n 1                  # Disk read/write per process
diagnose log device                # Disk space and quota used per device/ADOM
diagnose system print cpuinfo      # CPU hardware info
diagnose hardware info             # Detailed hardware info
diagnose system print df           # Disk partitions and usage
diagnose system print df -h        # Same, human-readable sizes
exe lvm info                       # Disk/LVM status and size
diagnose system print loadavg      # System load average
diagnose system print netstat      # Established connections and listening ports
diagnose system print route        # Routing table
diagnose fmnetwork interface list  # Interface IPs and RX/TX counters
diagnose fmnetwork arp list        # ARP table


### FAZ - Communication Debug ###

diagnose test application oftpd 3                 # Connected devices: IP, serial, uptime, packets
diagnose debug reset                              # Clear previous debug settings
diagnose debug application oftpd 8 <Device name>  # Debug OFTP for one device
diagnose debug enable                             # Start debug output
diagnose debug disable                            # Stop debug output
diagnose debug reset                              # Clear debug settings when done
diagnose sniffer packet any "host <device IP>"    # Capture traffic to/from a device
diagnose sniffer packet any "port 514"            # Capture log traffic (OFTP TCP / syslog UDP 514)


### FAZ - Logs from Devices ###

diagnose test application oftpd 50     # Log types received per device
diagnose log device                    # Space used per device/ADOM, incl. quotas
diagnose fortilogd lograte             # Log rate for last 5/30/60 sec
diagnose fortilogd lograte-adom all    # Log rate per ADOM and device type
diagnose fortilogd lograte-device      # Avg log rate per device (hour/day/week)
diagnose fortilogd lograte-total       # Total log rate for all devices
diagnose fortilogd msgrate             # Message rate received
diagnose sql status rebuild-db         # Check whether a DB rebuild is running


### FAZ - Licensing ###

diagnose dvm device list    # Devices registered, incl. license device/VDOM count
diagnose debug vminfo       # VM license: valid, type, GB/day, max devices
diagnose license list       # All applied licenses and expiry
get system loglimits        # Licensed GB/day and log rate limits


### FAZ - Shell Access ###

config system admin setting
set shell-access enable     # Enable Linux shell (asks for password)
end
execute shell               # Enter the shell


### FAZ - Extra ###

diagnose dvm adom list                  # ADOMs and their devices
diagnose dvm device list <device name>  # Details for one device
diagnose sql status run_sql_rebuild     # SQL rebuild progress
diagnose sql process list               # Running SQL queries (slow reports/log view)
diagnose cdb check adom-integrity       # ADOM database consistency check
diagnose debug crashlog read            # Daemon crash logs
diagnose system disk health             # Disk errors (hardware appliances)
diagnose system ntp status              # NTP sync (wrong time = missing logs)
